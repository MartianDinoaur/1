{
  "name": "favorite-things-poll",
  "version": "2.0.0",
  "private": true,
  "description": "Server-backed favorite polls with completion statistics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup:windows": "setup-windows.cmd",
    "start:lan": "HOST=0.0.0.0 node server.js",
    "autostart:on": "setup-windows.cmd",
    "autostart:off": "off-windows.cmd",
    "autostart:status": "status-windows.cmd",
    "check": "node --check server.js && node --check script.js"
  }
}
