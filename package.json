{
  "name": "favorite-things-poll",
  "version": "2.0.0",
  "private": true,
  "description": "Server-backed favorite polls with completion statistics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lan": "HOST=0.0.0.0 node server.js",
    "autostart:on": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows-autostart.ps1",
    "autostart:off": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/uninstall-windows-autostart.ps1",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-poll-control.ps1 status",
    "check": "node --check server.js && node --check script.js"
  }
}
